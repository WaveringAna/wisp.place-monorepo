{
  "name": "wispctl",
  "version": "1.3.1",
  "main": "./dist/index.js",
  "devDependencies": {
    "@atproto/api": "^0.20.28",
    "@atproto/identity": "^0.5.6",
    "@atproto/lex-cbor": "^0.0.9",
    "@atproto/lex-data": "^0.0.9",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/repo": "^0.8.13",
    "@atproto/sync": "^0.3.10",
    "@atproto/syntax": "^0.4.3",
    "@clack/prompts": "^0.10.1",
    "@hono/node-server": "^1.19.14",
    "@oven/bun-darwin-aarch64": "^1.3.14",
    "@types/bun": "^1.3.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.1",
    "@wispplace/atproto-utils": "file:../packages/@wispplace/atproto-utils",
    "@wispplace/bun-firehose": "file:../packages/@wispplace/bun-firehose",
    "@wispplace/constants": "file:../packages/@wispplace/constants",
    "@wispplace/fs-utils": "file:../packages/@wispplace/fs-utils",
    "@wispplace/lexicons": "file:../packages/@wispplace/lexicons",
    "@wispplace/page-generators": "file:../packages/@wispplace/page-generators",
    "commander": "^14.0.3",
    "hono": "^4.12.30",
    "ignore": "^7.0.6",
    "mime-types": "^3.0.2",
    "multiformats": "^13.4.2",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "wispctl": "dist/index.js"
  },
  "description": "CLI for wisp.place - deploy static sites to the AT Protocol",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target node --sourcemap=linked --external @napi-rs/keyring --external '@napi-rs/keyring-*' && bun -e \"const f = Bun.file('./dist/index.js'); await Bun.write(f, (await f.text()).replace('#!/usr/bin/env bun', '#!/usr/bin/env node'));\"",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
