{
  "name": "create-wisp",
  "version": "1.0.5",
  "description": "CLI for wisp.place - deploy static sites to the AT Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-wisp": "dist/index.js",
    "wisp-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target node --sourcemap=linked && sed -i '' '1s|#!/usr/bin/env bun|#!/usr/bin/env node|' ./dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@atproto/api": "^0.18.17",
    "@atproto/identity": "^0.4.10",
    "@atproto/lex-cbor": "^0.0.9",
    "@atproto/lex-data": "^0.0.9",
    "@atproto/oauth-client-node": "^0.3.15",
    "@atproto/repo": "^0.8.12",
    "@atproto/sync": "^0.1.39",
    "@atproto/syntax": "^0.4.3",
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.4",
    "multiformats": "^13.4.2",
    "@clack/prompts": "^0.10.0",
    "@wisp/atproto-utils": "workspace:*",
    "@wisp/constants": "workspace:*",
    "@wisp/fs-utils": "workspace:*",
    "@wisp/lexicons": "workspace:*",
    "commander": "^14.0.2",
    "ignore": "^7.0.5",
    "mime-types": "^3.0.2",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "@types/bun": "latest",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "typescript": "^5"
  }
}
