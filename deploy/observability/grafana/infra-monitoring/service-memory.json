{
  "uid": "wisp-service-memory",
  "id": null,
  "title": "services \u00b7 memory",
  "tags": [
    "hosting",
    "firehose",
    "main",
    "wisp"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "instances",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria-metrics"
        },
        "query": {
          "query": "label_values(process_uptime_seconds, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(process_uptime_seconds, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "rss \u00b7 by service instance",
      "type": "timeseries",
      "description": "Resident set size of each service process (process.memoryUsage().rss). Includes shared pages such as the mapped bun binary, so it can exceed the cgroup's anon memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_memory_bytes{kind=\"rss\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "heap used and external \u00b7 by service instance",
      "type": "timeseries",
      "description": "JS heap used and memory held outside the JS heap. Under Bun (JavaScriptCore) heap_used also counts external memory and can exceed heap_total; Buffers and typed arrays show up in external, not array_buffers.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_memory_bytes{kind=\"heap_used\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}} \u00b7 heap_used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_memory_bytes{kind=\"external\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}} \u00b7 external",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "array buffers \u00b7 by service instance",
      "type": "timeseries",
      "description": "process.memoryUsage().arrayBuffers. Bun counts only explicit ArrayBuffer objects here; Buffer.alloc and new Uint8Array(n) are in external instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_memory_bytes{kind=\"array_buffers\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "container anon, file and swap \u00b7 cgroup v2",
      "type": "timeseries",
      "description": "From the container's memory.stat (anon, file) and memory.swap.current. anon is what grows with leaks; file is page cache the kernel can reclaim.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "cgroup_memory_bytes{kind=~\"anon|file|swap\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}} \u00b7 {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "container memory vs limit",
      "type": "timeseries",
      "description": "memory.current as a share of memory.max. Absent for a container without a memory limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "cgroup_memory_bytes{kind=\"current\", instance=~\"${instance:regex}\"} / ignoring (kind) cgroup_memory_bytes{kind=\"limit\", instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "uptime \u00b7 by service instance",
      "type": "timeseries",
      "description": "Seconds since each process started; a drop is a restart. Compare memory at equal uptime across restarts below.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_uptime_seconds{instance=~\"${instance:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "growth \u00b7 linear slope per hour of rss and container anon",
      "type": "table",
      "description": "Current uptime and memory, and the least-squares slope (bytes per hour) over the last 6 h and 24 h. A slope computed across a restart mixes two lifetimes, so trust the 24 h column only where uptime is above 24 h.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (process_uptime_seconds{instance=~\"${instance:regex}\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (process_memory_bytes{kind=\"rss\", instance=~\"${instance:regex}\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (cgroup_memory_bytes{kind=\"anon\", instance=~\"${instance:regex}\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (deriv(process_memory_bytes{kind=\"rss\", instance=~\"${instance:regex}\"}[6h]) * 3600)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "D",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (deriv(process_memory_bytes{kind=\"rss\", instance=~\"${instance:regex}\"}[24h]) * 3600)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "E",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "max by (instance) (deriv(cgroup_memory_bytes{kind=\"anon\", instance=~\"${instance:regex}\"}[24h]) * 3600)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "F",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "uptime",
              "Value #B": "rss",
              "Value #C": "anon",
              "Value #D": "rss slope 6h /h",
              "Value #E": "rss slope 24h /h",
              "Value #F": "anon slope 24h /h"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "rss slope 24h /h",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "anon at equal uptime \u00b7 $instance",
      "type": "xychart",
      "repeat": "instance",
      "repeatDirection": "v",
      "description": "Container anon memory (the cgroup's own heap and stack pages, not page cache) against process uptime instead of wall time, so every restart in the range overlays from 0. If memory at the same uptime keeps climbing from one lifetime to the next, or a lifetime keeps climbing where earlier ones flattened, that is growth rather than warm-up. Widen the time range to include several restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "process_uptime_seconds{instance=\"$instance\"}",
          "instant": false,
          "range": true,
          "legendFormat": "uptime",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "cgroup_memory_bytes{kind=\"anon\", instance=\"$instance\"}",
          "instant": false,
          "range": true,
          "legendFormat": "anon",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 4
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "auto",
        "series": [
          {}
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "rss at equal uptime \u00b7 $instance",
      "type": "xychart",
      "repeat": "instance",
      "repeatDirection": "v",
