      "title": "parent scrape",
      "type": "stat",
      "description": "VictoriaMetrics scraping the valefar parent; 1 = OK, 0 = failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "up{job=\"netdata-fleet\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
