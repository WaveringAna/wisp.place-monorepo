          "editorMode": "code",
          "expr": "100 * sum by (instance) (netdata_disk_space_GiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\",mount_point=\"/\",dimension=\"used\"}) / sum by (instance) (netdata_disk_space_GiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\",mount_point=\"/\",dimension=~\"used|avail\"})",
          "instant": false,
