          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "RAM unavailable",
      "type": "timeseries",
      "description": "Linux: 100 \u00d7 (1 \u2212 MemAvailable / total). macOS fallback: treats free + inactive as available; an estimate, not macOS memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "(100 * (1 - max by (instance) (netdata_mem_available_MiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\",dimension=\"avail\"}) / sum by (instance) (netdata_system_ram_MiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\"}))) or on (instance) (100 * (1 - sum by (instance) (netdata_system_ram_MiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\",dimension=~\"free|inactive\"}) / sum by (instance) (netdata_system_ram_MiB_average{job=\"netdata-fleet\",instance=~\"${node:regex}\",dimension=~\"active|compressor|free|inactive|wired\"})))",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
