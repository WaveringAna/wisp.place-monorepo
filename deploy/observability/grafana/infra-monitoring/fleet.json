    {
      "id": 5,
      "title": "node inventory \u00b7 1 reporting / 0 missing",
      "type": "table",
      "description": "Every Netdata-known host is listed, including offline hosts with no metrics. `instance` is the source hostname.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "editorMode": "code",
          "expr": "clamp_max(count by (instance) (netdata_system_uptime_seconds_average{job=\"netdata-fleet\",instance=~\"${node:regex}\"}), 1) or on (instance) (0 * max by (instance) (netdata_info{job=\"netdata-fleet\",instance=~\"${node:regex}\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "title": "CPU busy",
      "type": "timeseries",
      "description": "Percentage of CPU not idle; aggregated across cores by Netdata.",
