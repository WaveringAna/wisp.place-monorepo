{
  "name": "@wispplace/monorepo",
  "version": "1.0.50",
  "private": true,
  "workspaces": [
    "packages/@wispplace/*",
    "apps/main-app",
    "apps/hosting-service",
    "apps/firehose-service",
    "apps/webhook-service",
    "cli"
  ],
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^25.9.5",
    "bun-plugin-tailwind": "^0.1.2",
    "node-html-parser": "^7.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "bun test",
		"dev": "bun run build && bun run --watch apps/main-app/src/index.ts",
    "dev:infra": "./scripts/dev-infra.sh up",
    "dev:infra:down": "./scripts/dev-infra.sh down",
    "start": "bun run apps/main-app/src/index.ts",
    "build": "cd apps/main-app && bun run build",
    "build:hosting": "cd apps/hosting-service && npm run build",
    "build:all": "bun run build && npm run build:hosting",
    "check": "bun tsc --noEmit",
    "screenshot": "bun run apps/main-app/scripts/screenshot-sites.ts",
    "site-images": "bun run apps/main-app/scripts/poll-site-images.ts",
    "hosting:dev": "cd apps/hosting-service && npm run dev",
    "hosting:start": "cd apps/hosting-service && npm run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "e2e:harness": "docker compose -p wispplace-monorepo-e2e -f docker-compose.dev.yml -f docker-compose.e2e.yml --profile dev up --build --abort-on-container-exit --exit-code-from e2e-runner e2e-runner",
    "e2e:harness:down": "docker compose -p wispplace-monorepo-e2e -f docker-compose.dev.yml -f docker-compose.e2e.yml --profile dev down -v --remove-orphans",
    "codegen": "./scripts/codegen.sh",
    "download:aturi": "bun run scripts/download-place-wisp-fs.ts",
    "publish:permission-sets": "bun run scripts/publish-permission-sets.ts",
    "publish:cli": "cd cli && bun run build && npm publish && cd ../packages/create-wisp && npm publish"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "bun",
    "esbuild"
  ],
  "overrides": {
    "flatted": "3.4.2",
    "path-to-regexp": "0.1.13",
    "picomatch": "4.0.5",
    "postcss": "8.5.19",
    "qs": "6.15.3",
    "rollup": "4.62.2",
    "ts-morph": "28.0.0",
    "undici": "6.27.0",
    "vite": "7.3.6",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@oven/bun-darwin-aarch64": "^1.3.14",
    "@oven/bun-linux-x64": "^1.3.14",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  }
}
