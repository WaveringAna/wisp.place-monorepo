{
  "name": "@wispplace/monorepo",
  "version": "1.0.50",
  "private": true,
  "workspaces": [
    "packages/@wispplace/*",
    "apps/main-app",
    "apps/hosting-service",
    "apps/firehose-service",
    "apps/webhook-service",
    "cli"
  ],
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@types/node": "^25.6.0",
    "bun-plugin-tailwind": "^0.1.2",
    "node-html-parser": "^7.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch apps/main-app/src/index.ts",
    "start": "bun run apps/main-app/src/index.ts",
    "build": "cd apps/main-app && bun run build.ts",
    "build:hosting": "cd apps/hosting-service && npm run build",
    "build:all": "bun run build && npm run build:hosting",
    "check": "bun tsc --noEmit",
    "screenshot": "bun run apps/main-app/scripts/screenshot-sites.ts",
    "site-images": "bun run apps/main-app/scripts/poll-site-images.ts",
    "hosting:dev": "cd apps/hosting-service && npm run dev",
    "hosting:start": "cd apps/hosting-service && npm run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "e2e:harness": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e-runner e2e-runner",
    "e2e:harness:down": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans",
    "codegen": "./scripts/codegen.sh",
    "download:aturi": "bun run scripts/download-place-wisp-fs.ts",
    "publish:cli": "cd cli && bun run build && npm publish && cd ../packages/create-wisp && npm publish"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "bun",
    "esbuild"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@oven/bun-darwin-aarch64": "^1.3.6",
    "@oven/bun-linux-x64": "^1.3.6",
    "@types/bun": "^1.3.5",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2"
  }
}
