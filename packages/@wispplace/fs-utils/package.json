    },
    "./redirects": {
      "types": "./src/redirects.ts",
      "default": "./src/redirects.ts"
    },
    "./html-rewriter": {
      "types": "./src/html-rewriter.ts",
      "default": "./src/html-rewriter.ts"
    }
  },
  "dependencies": {
    "@atproto/api": "^0.18.17",
    "@wispplace/atproto-utils": "workspace:*",
    "@wispplace/lexicons": "workspace:*"
