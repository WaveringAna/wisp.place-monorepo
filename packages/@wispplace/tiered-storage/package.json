{
  "name": "@wispplace/tiered-storage",
  "version": "1.0.0",
  "private": true,
  "description": "Tiered storage library with S3, disk, and memory caching",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "example": "tsx example.ts",
    "serve": "tsx serve-example.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/lib-storage": "^3.1087.0",
    "hono": "^4.12.30",
    "mime-types": "^3.0.2",
    "tiny-lru": "^11.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
