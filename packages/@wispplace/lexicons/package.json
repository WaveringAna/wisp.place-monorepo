{
  "name": "@wispplace/lexicons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types/place/wisp/fs": {
      "types": "./src/types/place/wisp/fs.ts",
      "default": "./src/types/place/wisp/fs.ts"
    },
    "./types/place/wisp/settings": {
      "types": "./src/types/place/wisp/settings.ts",
      "default": "./src/types/place/wisp/settings.ts"
    },
    "./types/place/wisp/subfs": {
      "types": "./src/types/place/wisp/subfs.ts",
      "default": "./src/types/place/wisp/subfs.ts"
    },
    "./types/place/wisp/v2/wh": {
      "types": "./src/types/place/wisp/v2/wh.ts",
      "default": "./src/types/place/wisp/v2/wh.ts"
    },
    "./types/place/wisp/v2/domains": {
      "types": "./src/types/place/wisp/v2/domains.ts",
      "default": "./src/types/place/wisp/v2/domains.ts"
    },
    "./types/place/wisp/v2/domain/claim": {
      "types": "./src/types/place/wisp/v2/domain/claim.ts",
      "default": "./src/types/place/wisp/v2/domain/claim.ts"
    },
    "./types/place/wisp/v2/domain/claimSubdomain": {
      "types": "./src/types/place/wisp/v2/domain/claimSubdomain.ts",
      "default": "./src/types/place/wisp/v2/domain/claimSubdomain.ts"
    },
    "./types/place/wisp/v2/domain/addSite": {
      "types": "./src/types/place/wisp/v2/domain/addSite.ts",
      "default": "./src/types/place/wisp/v2/domain/addSite.ts"
    },
    "./types/place/wisp/v2/domain/delete": {
      "types": "./src/types/place/wisp/v2/domain/delete.ts",
      "default": "./src/types/place/wisp/v2/domain/delete.ts"
    },
    "./types/place/wisp/v2/domain/verify": {
      "types": "./src/types/place/wisp/v2/domain/verify.ts",
      "default": "./src/types/place/wisp/v2/domain/verify.ts"
    },
    "./types/place/wisp/v2/domain/getList": {
      "types": "./src/types/place/wisp/v2/domain/getList.ts",
      "default": "./src/types/place/wisp/v2/domain/getList.ts"
    },
    "./types/place/wisp/v2/domain/getStatus": {
      "types": "./src/types/place/wisp/v2/domain/getStatus.ts",
      "default": "./src/types/place/wisp/v2/domain/getStatus.ts"
    },
    "./types/place/wisp/v2/site/delete": {
      "types": "./src/types/place/wisp/v2/site/delete.ts",
      "default": "./src/types/place/wisp/v2/site/delete.ts"
    },
    "./types/place/wisp/v2/site/getDomains": {
      "types": "./src/types/place/wisp/v2/site/getDomains.ts",
      "default": "./src/types/place/wisp/v2/site/getDomains.ts"
    },
    "./types/place/wisp/v2/site/getList": {
      "types": "./src/types/place/wisp/v2/site/getList.ts",
      "default": "./src/types/place/wisp/v2/site/getList.ts"
    },
    "./atcute": {
      "types": "./src/atcute/lexicons/index.ts",
      "default": "./src/atcute/lexicons/index.ts"
    },
    "./lexicons": {
      "types": "./src/lexicons.ts",
      "default": "./src/lexicons.ts"
    },
    "./util": {
      "types": "./src/util.ts",
      "default": "./src/util.ts"
    }
  },
  "scripts": {
    "codegen": "bun run codegen:server && bun run codegen:atcute && bun run codegen:verify",
    "codegen:server": "lex gen-server ./src ../../../lexicons/*.json",
    "codegen:atcute": "lex-cli generate -c lex.atcute.config.js",
    "codegen:verify": "test -f ./src/atcute/lexicons/index.ts"
  },
  "dependencies": {
    "@atcute/lexicons": "^1.2.9",
    "@atproto/lexicon": "^0.7.7",
    "@atproto/xrpc-server": "^0.11.9"
  },
  "devDependencies": {
    "@atcute/lex-cli": "^2.5.3",
    "@atproto/lex-cli": "^0.10.6",
    "multiformats": "^13.4.1"
  }
}
