    "ignore": "^7.0.6",
    "iron-session": "^8.0.4",
    "multiformats": "^13.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "zlib": "^1.0.5"
