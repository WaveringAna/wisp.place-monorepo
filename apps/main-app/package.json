{
  "name": "@wispplace/main-app",
  "version": "1.0.50",
  "private": true,
  "scripts": {
    "test": "NODE_ENV=test bun test --isolate",
    "dev": "NODE_ENV=development bun run build && NODE_ENV=development bun run --watch src/index.ts",
