    "@atproto-labs/did-resolver": "^0.2.6",
    "@atproto/api": "^0.20.28",
    "@atproto/common-web": "^0.4.21",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/lex-cli": "^0.10.6",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/xrpc-server": "^0.11.9",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "@tanstack/react-query": "^5.101.2",
    "@wispplace/atproto-utils": "workspace:*",
