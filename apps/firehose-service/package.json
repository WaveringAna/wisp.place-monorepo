{
  "name": "firehose-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' tsx --env-file=.env src/index.ts",
    "dev:backfill": "NODE_OPTIONS='--max-old-space-size=2048' tsx --env-file=.env src/index.ts --backfill",
    "build": "bun run build.ts",
    "start": "NODE_OPTIONS='--max-old-space-size=2048' tsx src/index.ts",
    "check": "tsc --noEmit",
    "backfill": "NODE_OPTIONS='--max-old-space-size=2048' tsx src/index.ts --backfill"
  },
  "dependencies": {
    "@atproto/api": "^0.17.4",
    "@atproto/identity": "^0.4.9",
    "@atproto/sync": "^0.1.36",
    "@hono/node-server": "^1.19.6",
    "@wispplace/atproto-utils": "workspace:*",
    "@wispplace/bun-firehose": "workspace:*",
    "@wispplace/database": "workspace:*",
    "@wispplace/fs-utils": "workspace:*",
    "@wispplace/lexicons": "workspace:*",
    "@wispplace/safe-fetch": "workspace:*",
    "@wispplace/tiered-storage": "workspace:*",
    "hono": "^4.10.4",
    "ioredis": "^5.9.2",
    "multiformats": "^13.4.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
