{
  "name": "wisp-hosting-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' tsx --env-file=.env  src/index.ts",
    "build": "bun run build.ts",
    "start": "NODE_OPTIONS='--max-old-space-size=2048' tsx src/index.ts",
    "check": "tsc --noEmit",
    "backfill": "NODE_OPTIONS='--max-old-space-size=2048' tsx src/index.ts --backfill"
  },
  "dependencies": {
    "@atproto/api": "^0.17.4",
    "@atproto/identity": "^0.4.9",
    "@atproto/lexicon": "^0.5.2",
    "@atproto/sync": "^0.1.36",
    "@atproto/xrpc": "^0.7.5",
    "@hono/node-server": "^1.19.6",
    "@wisp/atproto-utils": "workspace:*",
    "@wisp/constants": "workspace:*",
    "@wisp/database": "workspace:*",
    "@wisp/fs-utils": "workspace:*",
    "@wisp/lexicons": "workspace:*",
    "@wisp/observability": "workspace:*",
    "@wisp/safe-fetch": "workspace:*",
    "hono": "^4.10.4",
    "mime-types": "^2.1.35",
    "multiformats": "^13.4.1",
    "postgres": "^3.4.5",
    "tiered-storage": "1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
