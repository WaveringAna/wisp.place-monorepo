---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page isn't here." path="/404" narrow noindex>
	<div class="notfound">
		<p class="notfound__code">404</p>
		<p>That post drifted off. It may have been renamed, or never existed.</p>
		<a class="button" href="/">&larr; Back to all posts</a>
	</div>
</Base>
