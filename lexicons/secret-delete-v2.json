{
    "lexicon": 1,
    "id": "place.wisp.v2.secret.delete",
    "defs": {
        "main": {
            "type": "procedure",
            "description": "Delete a webhook signing secret by name.",
            "input": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                        "name": {
                            "type": "string",
                            "format": "record-key",
                            "maxLength": 64,
                            "description": "1–64 character server-managed secret ID. Use ASCII letters, digits, dots, underscores, and hyphens only."
                        }
                    }
                }
            },
            "errors": [
                { "name": "AuthenticationRequired" },
                { "name": "InvalidRequest" },
                { "name": "NotFound" }
            ]
        }
    }
}
