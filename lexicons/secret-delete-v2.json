{
    "lexicon": 1,
    "id": "place.wisp.v2.secret.delete",
    "defs": {
        "main": {
            "type": "procedure",
            "description": "Delete a webhook signing secret by name.",
            "input": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                        "name": { "type": "string", "format": "record-key" }
                    }
                }
            },
            "errors": [
                { "name": "AuthenticationRequired" },
                { "name": "NotFound" }
            ]
        }
    }
}
