{
    "lexicon": 1,
    "id": "place.wisp.v2.secret.list",
    "defs": {
        "main": {
            "type": "query",
            "description": "List webhook signing secrets for the caller DID. Token values are never returned.",
            "output": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": ["secrets"],
                    "properties": {
                        "secrets": {
                            "type": "array",
                            "items": { "type": "ref", "ref": "#secretMeta" }
                        }
                    }
                }
            },
            "errors": [
                { "name": "AuthenticationRequired" }
            ]
        },
        "secretMeta": {
            "type": "object",
            "required": ["name", "createdAt"],
            "properties": {
                "name": { "type": "string" },
                "createdAt": { "type": "string", "format": "datetime" },
                "lastRotatedAt": { "type": "string", "format": "datetime" }
            }
        }
    }
}
