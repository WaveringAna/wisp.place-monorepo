# wisp services run on the host; infrastructure and the reference pds run in compose.
NODE_ENV=development
LOCAL_DEV=true
PORT=8000
DOMAIN=http://127.0.0.1:8000
CLIENT_NAME=Wisp.Place Dev
BASE_DOMAIN=wisp.localhost
PRIVATE_HOST=priv.wisp.localhost:3001

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wisp
REDIS_URL=redis://127.0.0.1:6379

S3_BUCKET=wisp-dev
PRIVATE_S3_BUCKET=wisp-private-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Where a private origin sends visitors to prove their identity. The private hosts cannot
# read the account cookie by design, so sign-in happens on main-app and returns a handoff.
MAIN_APP_URL=http://localhost:8000

HOSTING_SERVICE_URL=http://127.0.0.1:3001
HOSTING_PORT=3001
BASE_HOST=wisp.localhost

FIREHOSE_SERVICE=ws://localhost:3300
FIREHOSE_SERVICE_SECONDARY=
HEALTH_PORT=3002
WISP_PLC_DIRECTORY_URL=http://127.0.0.1:2582
PDS_FETCH_REWRITE_FROM=http://localhost:3300
PDS_FETCH_REWRITE_TO=http://pds.localhost:3300

OAUTH_HANDLE_RESOLVER_URL=http://localhost:3300/xrpc/com.atproto.identity.resolveHandle
OAUTH_PLC_DIRECTORY_URL=http://127.0.0.1:2582
OAUTH_ALLOW_HTTP=true

SKIP_ADMIN_SETUP=true
DISABLE_DNS_WORKER=true

# Host port overrides for the dev infrastructure. Change these if another local
# service already binds the defaults; docker-compose.dev.yml reads them directly.
# Remember to update DATABASE_URL and REDIS_URL to match.
# DEV_POSTGRES_PORT=5432
# DEV_REDIS_PORT=6379
